# Copy this file to .env.local and fill in the real values.
#
# Both variables are NEXT_PUBLIC_*, which means their values are inlined into
# the client bundle at build time and are visible to anyone who views source.
# That is expected for analytics IDs — they are public identifiers, not secrets.
#
# Analytics only renders when NODE_ENV === "production" AND the relevant ID is
# non-empty (see components/Analytics.tsx). Leaving either blank silently
# disables that tracker rather than emitting a broken script tag.

# Google Analytics 4 measurement ID.
# Found in GA4 under Admin > Data streams > your web stream.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=""

# Meta (Facebook) Pixel ID.
# Found in Meta Events Manager > Data sources > your pixel.
# Format: a 15-16 digit number, e.g. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=""
